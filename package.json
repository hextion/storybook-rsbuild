{
  "name": "storybook-rsbuild-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["packages/*", "sandboxes/*", "scripts", "website"],
  "scripts": {
    "build": "cross-env NX_DAEMON=false nx run-many -t build --exclude \"@sandboxes/*\"",
    "build:sandboxes": "cross-env NX_DAEMON=false nx run-many -t build:storybook --projects \"@sandboxes/*\"",
    "check": "cross-env NX_DAEMON=false nx run-many -t check",
    "check-dependency-version": "yarn tsx CDVC.mts",
    "dev": "yarn workspaces foreach -Ap run prepare --watch",
    "lint": "biome check",
    "test": "cross-env NODE_OPTIONS=--max_old_space_size=4096 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max_old_space_size=4096 vitest watch"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{json,css,less,scss}": "biome check --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "biome check --write",
    "**/package.json": ["sort-package-json", "biome check --write"]
  },
  "resolutions": {
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.28.1",
    "@testing-library/jest-dom": "^6.6.3",
    "check-dependency-version-consistency": "^4.1.1",
    "cross-env": "^7.0.3",
    "jiti": "^2.6.1",
    "nano-staged": "^0.8.0",
    "nx": "^20.4.6",
    "simple-git-hooks": "^2.11.1",
    "sort-package-json": "^2.12.0",
    "ts-dedent": "^2.2.0",
    "tsx": "^4.19.4",
    "typescript": "*",
    "vitest": "^2.1.9"
  },
  "packageManager": "yarn@4.13.0"
}
