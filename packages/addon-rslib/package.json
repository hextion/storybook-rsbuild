{
  "name": "@balafla/storybook-addon-rslib",
  "version": "1.0.3",
  "description": "Storybook addon for loading configuration of Rslib",
  "keywords": ["storybook", "storybook-addons", "rsbuild", "rspack", "rslib"],
  "homepage": "https://storybook.rsbuild.dev",
  "bugs": {
    "url": "https://github.com/rspack-contrib/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rspack-contrib/storybook-rsbuild",
    "directory": "packages/addon-rslib"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/**/*", "README.md", "*.js", "*.d.ts", "!src/**/*"],
  "scripts": {
    "build": "yarn run prep --optimized",
    "check": "jiti ../../scripts/prepare/check.ts",
    "prep": "jiti ../../scripts/prepare/bundle.ts",
    "prepare": "yarn run build"
  },
  "devDependencies": {
    "@balafla/storybook-builder-rsbuild": "workspace:*",
    "@rsbuild/core": "^1.3.22",
    "@rslib/core": "^0.19.6",
    "@types/node": "^24.0.0",
    "storybook": "^7.6.24",
    "typescript": "*"
  },
  "peerDependencies": {
    "@balafla/storybook-builder-rsbuild": "*",
    "@rsbuild/core": "^1.0.1",
    "@rslib/core": ">= 0.1.1 || >= 0.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": ["./src/index.ts", "./src/preset.ts"],
    "platform": "node"
  }
}
