{
  "name": "@balafla/storybook-vue3-rsbuild",
  "version": "1.0.0",
  "description": "Storybook for Vue3 and Rsbuild: Develop React Component in isolation with Hot Reloading.",
  "keywords": [
    "storybook",
    "rsbuild",
    "rspack",
    "vue3"
  ],
  "homepage": "https://storybook.rsbuild.dev",
  "bugs": {
    "url": "https://github.com/hextion/storybook-rsbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hextion/storybook-rsbuild.git",
    "directory": "packages/framework-vue3"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "require": "./dist/preset.js"
    },
    "./react-docs": {
      "types": "./dist/react-docs.d.ts",
      "require": "./dist/react-docs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "yarn run prep --optimized",
    "check": "jiti ../../scripts/prepare/check.ts",
    "prep": "jiti ../../scripts/prepare/bundle.ts"
  },
  "dependencies": {
    "@balafla/storybook-builder-rsbuild": "^1.0.0",
    "@storybook/docs-tools": "^7.6.24",
    "@storybook/types": "^7.6.24",
    "@storybook/vue3": "^7.6.24",
    "vue-docgen-api": "^4.46.0",
    "vue-docgen-loader": "^1.5.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.3.22",
    "@types/node": "^24.0.0",
    "storybook": "^7.6.24",
    "typescript": "*",
    "vue": "^3.5.16"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.1",
    "storybook": "^7.6.24",
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "entries": [
      "./src/index.ts",
      "./src/preset.ts"
    ],
    "platform": "node"
  }
}
