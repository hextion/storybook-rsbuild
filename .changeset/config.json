{
  "$schema": "https://unpkg.com/@changesets/config@3.1.3/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    { "repo": "hextion/storybook-rsbuild" }
  ],
  "commit": false,
  "privatePackages": { "version": false, "tag": false },
  "linked": [],
  "access": "public",
  "baseBranch": "storybook-v7",
  "fixed": [
    [
      "@balafla/storybook-addon-rslib",
      "@balafla/storybook-builder-rsbuild",
      "@balafla/storybook-html-rsbuild",
      "@balafla/storybook-react-rsbuild",
      "@balafla/storybook-vue3-rsbuild",
      "@balafla/storybook-web-components-rsbuild"
    ]
  ],
  "___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": {
    "onlyUpdatePeerDependentsWhenOutOfRange": true,
    "updateInternalDependents": "always"
  },
  "updateInternalDependencies": "patch",
  "ignore": [],
  "snapshot": {
    "prereleaseTemplate": "{commit}",
    "useCalculatedVersion": true
  }
}
